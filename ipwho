#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly ROOT_DIR

# shellcheck source=lib/sync.sh
source "$ROOT_DIR/lib/sync.sh"

# shellcheck source=lib/lookup.sh
source "$ROOT_DIR/lib/lookup.sh"

usage() {
  printf '%s\n' \
    'Usage:' \
    '  ipwho sync [--gcp-project PROJECT ...] [--ovh]' \
    '  ipwho IPV4' \
    '  ipwho HOST' \
    '  ipwho --help' \
    '' \
    'sync writes a local JSON cache for the selected GCP projects and/or OVH dedicated servers.' \
    'Cache: ~/.cache/ipwho/cache.json, or XDG_CACHE_HOME/ipwho/cache.json when set.' \
    'IPV4 or HOST searches the local cache only; no DNS or cloud requests are made.'
}

main() {
  local -a GCP_PROJECTS=()
  local SYNC_OVH=0
  local project duplicate

  case "${1:-}" in
  sync)
    shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
      --gcp-project)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* || "${2:-}" == *[[:space:]]* ]]; then
          printf 'Error: --gcp-project requires a non-empty project ID without whitespace.\n' >&2
          return 2
        fi

        duplicate=0
        if [[ ${#GCP_PROJECTS[@]} -gt 0 ]]; then
          for project in "${GCP_PROJECTS[@]}"; do
            if [[ "$project" == "$2" ]]; then
              duplicate=1
              break
            fi
          done
        fi
        if [[ "$duplicate" -eq 0 ]]; then
          GCP_PROJECTS+=("$2")
        fi
        shift 2
        ;;
      --ovh)
        SYNC_OVH=1
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        printf 'Error: unknown sync argument: %s. See ipwho --help.\n' "$1" >&2
        return 2
        ;;
      esac
    done

    if [[ ${#GCP_PROJECTS[@]} -eq 0 && "$SYNC_OVH" -eq 0 ]]; then
      printf 'Error: sync requires --gcp-project PROJECT and/or --ovh.\n' >&2
      return 2
    fi
    sync
    ;;
  -h | --help)
    usage
    ;;
  '')
    usage >&2
    return 2
    ;;
  -*)
    printf 'Error: unknown option: %s. See ipwho --help.\n' "$1" >&2
    return 2
    ;;
  *)
    if [[ $# -ne 1 ]]; then
      printf 'Error: lookup expects a single IPv4 address or hostname.\n' >&2
      return 2
    fi
    lookup "$1"
    ;;
  esac
}

main "$@"
